<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
		<PackageReference Include="Google.Protobuf" Version="3.34.2" />
		<PackageReference Include="Quartz" Version="3.20.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoinPayProxy.Domain\CoinPayProxy.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Protos\**\*.proto" GrpcServices="Server" Link="Protos\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="StowayNet.Extensions.DependencyInjection">
			<HintPath>..\dll\StowayNet.Extensions.DependencyInjection.dll</HintPath>
		</Reference>
		<Reference Include="TronNet">
			<HintPath>..\dll\TronNet.dll</HintPath>
		</Reference>
		<Reference Include="TronNet.ABI">
			<HintPath>..\dll\TronNet.ABI.dll</HintPath>
		</Reference>
		<Reference Include="TronNet.Crypto">
			<HintPath>..\dll\TronNet.Crypto.dll</HintPath>
		</Reference>
		<Reference Include="TronNet.Protocol">
			<HintPath>..\dll\TronNet.Protocol.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Dockerfile">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
